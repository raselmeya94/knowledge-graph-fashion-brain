{
  "name": "ecom-products-ontology",
  "version": "1.2.0",
  "description": "E-commerce scrape graph ontology for master_products (Zara, Primark, Matalan, C&A, Walmart). Product is central. Raw scrape tables stay in Postgres; Neo4j holds Product links for brand, category hierarchy, target group, material composition, style attributes, color, size-level availability, price history, sustainability, origin, images, and cross-brand similarity. Edges carry provenance (column, rule, or llm) and confidence.",
  "entity_types": [
    "Product",
    "ProductListing",
    "Reference",
    "Brand",
    "Domain",
    "Catalog",
    "ScrapeJob",
    "Section",
    "TargetGroup",
    "GarmentCategory",
    "Family",
    "Subfamily",
    "Material",
    "MaterialGroup",
    "Certification",
    "Construction",
    "Fit",
    "Silhouette",
    "Neckline",
    "SleeveLength",
    "GarmentLength",
    "Closure",
    "Pattern",
    "Occasion",
    "Season",
    "StyleTag",
    "Color",
    "ColorFamily",
    "Size",
    "SizeAvailability",
    "Availability",
    "AvailabilitySnapshot",
    "Currency",
    "FxRate",
    "PriceBand",
    "PriceSnapshot",
    "PriceChangeEvent",
    "CareInstruction",
    "Country",
    "Image",
    "ProductVersion"
  ],
  "entity_properties": {
    "Product": ["master_id", "brand", "name", "description", "price", "original_price", "price_min", "price_max", "price_usd", "discount_pct", "on_sale", "image_count", "color_count", "colorway_tile_count", "in_stock_count", "out_stock_count", "stock_ratio", "pdp_enriched", "content_hash", "colorway_hash", "first_seen_at", "scraped_at", "last_changed_at", "product_url", "embedding"],
    "ProductListing": ["catalog_product_id", "product_id", "seo_product_id", "product_url", "product_url_with_variant"],
    "Reference": ["reference", "display_reference"],
    "Brand": ["name", "positioning", "home_country"],
    "Domain": ["domain"],
    "Catalog": ["catalog_id"],
    "ScrapeJob": ["scrape_job_id", "scraped_at", "scraped_date"],
    "Section": ["name"],
    "TargetGroup": ["name", "gender", "age_group"],
    "GarmentCategory": ["name", "level", "category_path"],
    "Family": ["name"],
    "Subfamily": ["name"],
    "Material": ["name", "canonical_name", "is_recycled", "is_organic"],
    "MaterialGroup": ["name"],
    "Certification": ["name", "scheme"],
    "Construction": ["name"],
    "Fit": ["name"],
    "Silhouette": ["name"],
    "Neckline": ["name"],
    "SleeveLength": ["name"],
    "GarmentLength": ["name"],
    "Closure": ["name"],
    "Pattern": ["name"],
    "Occasion": ["name"],
    "Season": ["name"],
    "StyleTag": ["name"],
    "Color": ["name", "canonical_name", "hex"],
    "ColorFamily": ["name"],
    "Size": ["label", "system", "ordinal"],
    "SizeAvailability": ["in_stock", "observed_at"],
    "Availability": ["status"],
    "AvailabilitySnapshot": ["status", "in_stock_count", "out_stock_count", "observed_at"],
    "Currency": ["code"],
    "FxRate": ["from", "to", "rate", "as_of"],
    "PriceBand": ["label", "currency", "min", "max", "scope"],
    "PriceSnapshot": ["price", "original_price", "currency", "observed_at"],
    "PriceChangeEvent": ["old_price", "new_price", "delta", "delta_pct", "direction", "observed_at"],
    "CareInstruction": ["text", "action"],
    "Country": ["name", "iso2"],
    "Image": ["url", "position"],
    "ProductVersion": ["content_hash", "colorway_hash", "valid_from", "valid_to"]
  },
  "relationship_allowlist": {
    "HAS_BRAND": [["Product", "Brand"]],
    "SOLD_BY": [["Brand", "Domain"]],
    "SCRAPED_FROM": [["Product", "Domain"]],
    "IN_CATALOG": [["Product", "Catalog"]],
    "SCRAPED_IN_JOB": [["Product", "ScrapeJob"], ["PriceSnapshot", "ScrapeJob"], ["AvailabilitySnapshot", "ScrapeJob"]],
    "HAS_LISTING": [["Product", "ProductListing"]],
    "LISTING_IN_CATALOG": [["ProductListing", "Catalog"]],
    "HAS_REFERENCE": [["Product", "Reference"]],

    "HAS_SECTION": [["Product", "Section"]],
    "FOR_TARGET_GROUP": [["Product", "TargetGroup"], ["Section", "TargetGroup"]],
    "BELONGS_TO_CATEGORY": [["Product", "GarmentCategory"]],
    "HAS_SUB_CATEGORY": [["Product", "GarmentCategory"], ["Product", "Subfamily"]],
    "HAS_FAMILY": [["Product", "GarmentCategory"], ["Product", "Family"]],
    "HAS_SUBFAMILY": [["Product", "Subfamily"]],
    "PARENT_CATEGORY": [["GarmentCategory", "GarmentCategory"], ["Subfamily", "Family"], ["Family", "GarmentCategory"]],
    "CATEGORY_IN_SECTION": [["GarmentCategory", "Section"]],

    "USES_MATERIAL": [["Product", "Material"]],
    "PRIMARY_MATERIAL": [["Product", "Material"]],
    "IN_MATERIAL_GROUP": [["Material", "MaterialGroup"]],
    "HAS_CERTIFICATION": [["Product", "Certification"], ["Material", "Certification"]],
    "HAS_CONSTRUCTION": [["Product", "Construction"]],
    "HAS_FIT": [["Product", "Fit"]],
    "HAS_CARE": [["Product", "CareInstruction"]],
    "MADE_IN": [["Product", "Country"]],

    "HAS_SILHOUETTE": [["Product", "Silhouette"]],
    "HAS_NECKLINE": [["Product", "Neckline"]],
    "HAS_SLEEVE_LENGTH": [["Product", "SleeveLength"]],
    "HAS_LENGTH": [["Product", "GarmentLength"]],
    "HAS_CLOSURE": [["Product", "Closure"]],
    "HAS_PATTERN": [["Product", "Pattern"]],
    "SUITED_FOR_OCCASION": [["Product", "Occasion"]],
    "SUITED_FOR_SEASON": [["Product", "Season"]],
    "HAS_STYLE_TAG": [["Product", "StyleTag"]],

    "HAS_COLOR": [["Product", "Color"]],
    "PRIMARY_COLOR": [["Product", "Color"]],
    "IN_COLOR_FAMILY": [["Color", "ColorFamily"]],

    "HAS_SIZE_AVAILABILITY": [["Product", "SizeAvailability"]],
    "FOR_SIZE": [["SizeAvailability", "Size"]],
    "OF_COLOR": [["SizeAvailability", "Color"]],
    "HAS_AVAILABILITY": [["Product", "Availability"]],
    "HAS_AVAILABILITY_SNAPSHOT": [["Product", "AvailabilitySnapshot"]],
    "SNAPSHOT_STATUS": [["AvailabilitySnapshot", "Availability"]],

    "PRICED_IN": [["Product", "Currency"]],
    "IN_PRICE_BAND": [["Product", "PriceBand"]],
    "PRICE_BAND_IN_CURRENCY": [["PriceBand", "Currency"]],
    "HAS_PRICE_SNAPSHOT": [["Product", "PriceSnapshot"]],
    "SNAPSHOT_IN_CURRENCY": [["PriceSnapshot", "Currency"]],
    "HAS_PRICE_CHANGE": [["Product", "PriceChangeEvent"]],
    "FX_FROM": [["FxRate", "Currency"]],
    "FX_TO": [["FxRate", "Currency"]],

    "HAS_IMAGE": [["Product", "Image"]],
    "HAS_MAIN_IMAGE": [["Product", "Image"]],

    "HAS_VERSION": [["Product", "ProductVersion"]],
    "NEXT_VERSION": [["ProductVersion", "ProductVersion"]],
    "VARIANT_OF": [["Product", "Product"]],

    "SIMILAR_TO": [["Product", "Product"]],
    "CROSS_BRAND_MATCH": [["Product", "Product"]],
    "SAME_REFERENCE_AS": [["Product", "Product"]],
    "SUBSTITUTE_FOR": [["Product", "Product"]],
    "PRICED_HIGHER_THAN": [["Product", "Product"]],
    "COMPLEMENTS": [["Product", "Product"]],
    "SAME_STYLE_AS": [["Product", "Product"]]
  },
  "relationship_properties": {
    "common_provenance": ["source", "confidence", "extracted_at", "extractor_version"],
    "USES_MATERIAL": ["percentage", "rank", "is_primary", "part"],
    "PRIMARY_MATERIAL": ["percentage"],
    "HAS_CERTIFICATION": ["evidence_text"],
    "HAS_COLOR": ["position", "is_primary", "tile_index"],
    "HAS_AVAILABILITY": ["in_stock_count", "out_stock_count", "stock_ratio", "observed_at"],
    "PRICED_IN": ["price", "original_price", "price_min", "price_max", "discount_pct", "on_sale"],
    "HAS_PRICE_SNAPSHOT": ["observed_at", "seq"],
    "HAS_IMAGE": ["position"],
    "SCRAPED_IN_JOB": ["scraped_at"],
    "HAS_SIZE_AVAILABILITY": ["observed_at"],
    "HAS_STYLE_TAG": ["evidence_text"],
    "SUITED_FOR_OCCASION": ["evidence_text"],
    "SIMILAR_TO": ["score", "method", "shared_attributes"],
    "SAME_STYLE_AS": ["score", "method", "embedding_model"],
    "CROSS_BRAND_MATCH": ["score", "method", "confirmed", "matched_on"],
    "SUBSTITUTE_FOR": ["score", "price_delta", "price_delta_pct", "currency"],
    "PRICED_HIGHER_THAN": ["delta", "delta_pct", "currency", "basis"],
    "COMPLEMENTS": ["score", "method", "pair_type"],
    "VARIANT_OF": ["variant_type"],
    "NEXT_VERSION": ["changed_fields"]
  },
  "column_mapping": {
    "master_id": "Product.id ('<brand>:<master_id>')",
    "brand": "HAS_BRAND",
    "catalog_product_ids": "HAS_LISTING (one ProductListing per id)",
    "product_ids": "HAS_LISTING (one ProductListing per id)",
    "seo_product_id": "ProductListing.seo_product_id",
    "reference": "HAS_REFERENCE",
    "display_reference": "HAS_REFERENCE",
    "name": "LLM extraction: style attributes (see extraction)",
    "description": "LLM extraction: style attributes, certification, occasion (see extraction)",
    "composition_detail": "USES_MATERIAL (percentage, rank), PRIMARY_MATERIAL",
    "composition": "fallback parse for USES_MATERIAL; also HAS_CERTIFICATION via keywords (recycled, organic, BCI)",
    "construction": "HAS_CONSTRUCTION",
    "care": "HAS_CARE",
    "fit": "HAS_FIT",
    "country_of_origin": "MADE_IN",
    "section": "HAS_SECTION; FOR_TARGET_GROUP via rule mapping",
    "category": "BELONGS_TO_CATEGORY",
    "family": "HAS_FAMILY",
    "subfamily": "HAS_SUBFAMILY",
    "category_path": "PARENT_CATEGORY chain; also FOR_TARGET_GROUP when path contains women/men/kids/baby",
    "availability": "HAS_AVAILABILITY",
    "in_stock_count": "HAS_AVAILABILITY.in_stock_count; AvailabilitySnapshot per scrape",
    "out_stock_count": "HAS_AVAILABILITY.out_stock_count; AvailabilitySnapshot per scrape",
    "currency": "PRICED_IN",
    "price": "PRICED_IN.price (cast TEXT to numeric)",
    "original_price": "PRICED_IN.original_price, discount_pct, on_sale",
    "price_min": "PRICED_IN.price_min",
    "price_max": "PRICED_IN.price_max",
    "prices_seen": "HAS_PRICE_SNAPSHOT; HAS_PRICE_CHANGE when consecutive values differ",
    "image": "HAS_MAIN_IMAGE",
    "images": "HAS_IMAGE (position)",
    "colors": "HAS_COLOR, PRIMARY_COLOR (first)",
    "product_url": "Product.product_url",
    "domain": "SCRAPED_FROM",
    "catalog_id": "IN_CATALOG",
    "scrape_job_id": "SCRAPED_IN_JOB",
    "scraped_at": "SCRAPED_IN_JOB.scraped_at",
    "content_hash": "ProductVersion when the hash changes between scrapes",
    "colorway_hash": "ProductVersion when the hash changes between scrapes"
  },
  "extraction": {
    "note": "Attributes below are not in structured columns. Extract from name and description with an LLM using the closed vocabularies; reject out-of-vocabulary values. Store source='llm' and confidence on each edge; drop edges below min_confidence.",
    "min_confidence": 0.7,
    "targets": {
      "HAS_SILHOUETTE": ["slim", "regular", "relaxed", "oversized", "boxy", "a-line", "straight", "wide-leg", "flared", "tapered", "bodycon"],
      "HAS_NECKLINE": ["crew", "v-neck", "scoop", "square", "halter", "collared", "turtleneck", "boat", "off-shoulder", "hooded"],
      "HAS_SLEEVE_LENGTH": ["sleeveless", "short", "three-quarter", "long"],
      "HAS_LENGTH": ["cropped", "mini", "knee", "midi", "maxi", "ankle", "full"],
      "HAS_CLOSURE": ["button", "zip", "elastic", "drawstring", "buckle", "snap", "tie", "pull-on"],
      "HAS_PATTERN": ["solid", "striped", "checked", "floral", "graphic", "animal", "polka-dot", "embroidered", "textured"],
      "SUITED_FOR_OCCASION": ["casual", "work", "party", "formal", "sport", "lounge", "beach", "wedding"],
      "SUITED_FOR_SEASON": ["spring", "summer", "autumn", "winter", "all-season"],
      "HAS_STYLE_TAG": ["basic", "minimal", "vintage", "streetwear", "bohemian", "classic", "sporty", "trend-driven"],
      "HAS_CERTIFICATION": ["BCI", "GOTS", "OEKO-TEX", "recycled", "organic", "FSC", "Better Cotton", "Join Life"]
    }
  },
  "derived_relationships": {
    "FOR_TARGET_GROUP": "Rule map from section/category_path to TargetGroup: women, men, girls, boys, baby, unisex.",
    "IN_PRICE_BAND": "Bucket price per currency and section into quantile bands (budget / mid / premium).",
    "PRIMARY_MATERIAL": "Material with the highest percentage in composition_detail.",
    "IN_MATERIAL_GROUP": "Map Material to MaterialGroup: natural, synthetic, semi-synthetic.",
    "IN_COLOR_FAMILY": "Map normalized color names to ColorFamily (neutral, warm, cool, pastel, dark, print).",
    "CATEGORY_IN_SECTION": "Distinct (section, category) co-occurrence.",
    "HAS_PRICE_CHANGE": "Compare consecutive PriceSnapshot values; direction is up/down.",
    "HAS_AVAILABILITY_SNAPSHOT": "One per scrape job so stock history can be queried (restocks, sell-outs).",
    "HAS_VERSION / NEXT_VERSION": "New ProductVersion whenever content_hash or colorway_hash changes; changed_fields lists what differed.",
    "VARIANT_OF": "Products with the same reference/display_reference within a brand but different color or listing.",
    "CROSS_BRAND_MATCH": "Zara/Primark pairs with attribute overlap >= 0.8 as confirmed in the master build.",
    "SIMILAR_TO": "Same family/subfamily plus material, color and style overlap; weighted Jaccard; top-k per product.",
    "SAME_STYLE_AS": "Nearest neighbours by text/image embedding (Product.embedding) above a threshold; cross-brand allowed.",
    "SUBSTITUTE_FOR": "SIMILAR_TO or SAME_STYLE_AS where target is cheaper in the same section after FX normalization.",
    "PRICED_HIGHER_THAN": "Across brands within the same family and price basis, after FX normalization via FxRate.",
    "COMPLEMENTS": "Cross-category pairs (top with bottom, dress with outerwear) from same-section co-occurrence and color compatibility. Needs validation before use.",
    "SAME_REFERENCE_AS": "Products sharing reference/display_reference across brands or master rows."
  },
  "constraints": {
    "uniqueness": [
      "Product.id",
      "Brand.id",
      "Material.canonical_name",
      "Color.canonical_name",
      "Currency.code",
      "Catalog.catalog_id",
      "Domain.domain",
      "ScrapeJob.scrape_job_id",
      "ProductListing.catalog_product_id",
      "Size.label+system",
      "FxRate.from+to+as_of"
    ],
    "cardinality": {
      "HAS_BRAND": "exactly one per Product",
      "HAS_SECTION": "at most one per Product",
      "FOR_TARGET_GROUP": "at most one per Product",
      "BELONGS_TO_CATEGORY": "at most one per Product",
      "PRIMARY_MATERIAL": "at most one per Product",
      "PRIMARY_COLOR": "at most one per Product",
      "PRICED_IN": "at most one per Product",
      "HAS_AVAILABILITY": "at most one current per Product",
      "HAS_NECKLINE": "at most one per Product",
      "HAS_SLEEVE_LENGTH": "at most one per Product",
      "HAS_LENGTH": "at most one per Product",
      "HAS_PATTERN": "at most one per Product"
    },
    "notes": [
      "Skip edges when the source column is null; never create 'unknown' nodes.",
      "PriceSnapshot nodes only for distinct values in prices_seen; do not duplicate the current price.",
      "SIMILAR_TO, SAME_STYLE_AS and CROSS_BRAND_MATCH are stored once (lower id to higher id) and queried undirected.",
      "Style and certification edges are LLM-derived: keep provenance and confidence, and re-run when extractor_version changes.",
      "SizeAvailability and size nodes require per-size data from the scraper; master_products only has aggregate counts, so leave these empty until the scraper exports sizes.",
      "Raw scrape rows stay in Postgres; the graph holds only the fields above."
    ]
  },
  "normalization": {
    "material_aliases": {
      "cotton": ["Cotton", "COTTON", "organic cotton", "BCI cotton"],
      "polyester": ["Polyester", "POLYESTER", "recycled polyester", "PES"],
      "elastane": ["Elastane", "spandex", "lycra", "Lycra"],
      "viscose": ["Viscose", "VISCOSE", "rayon", "LENZING viscose"],
      "polyamide": ["Polyamide", "nylon", "Nylon"],
      "wool": ["Wool", "WOOL", "merino wool"],
      "linen": ["Linen", "LINEN"],
      "acrylic": ["Acrylic", "ACRYLIC"],
      "lyocell": ["Lyocell", "TENCEL lyocell", "tencel"]
    },
    "material_groups": {
      "natural": ["cotton", "wool", "linen", "silk"],
      "synthetic": ["polyester", "elastane", "polyamide", "acrylic"],
      "semi-synthetic": ["viscose", "lyocell", "modal"]
    },
    "target_groups": {
      "women": ["woman", "women", "ladies", "female"],
      "men": ["man", "men", "male"],
      "girls": ["girl", "girls"],
      "boys": ["boy", "boys"],
      "baby": ["baby", "newborn", "infant", "toddler"],
      "unisex": ["unisex"]
    },
    "availability_values": ["in_stock", "out_of_stock", "low_stock", "partial", "unknown"],
    "currency_codes": ["GBP", "EUR", "USD", "BDT"]
  },
  "review_stopwords": [],
  "review_min_token_length": 5,
  "canonical_entities": [
    {"id": "brand:zara", "type": "Brand", "name": "zara", "aliases": ["Zara", "ZARA"], "external_ids": []},
    {"id": "brand:primark", "type": "Brand", "name": "primark", "aliases": ["Primark", "PRIMARK"], "external_ids": []},
    {"id": "brand:matalan", "type": "Brand", "name": "matalan", "aliases": ["Matalan", "MATALAN"], "external_ids": []},
    {"id": "brand:c-and-a", "type": "Brand", "name": "c-and-a", "aliases": ["C&A", "c&a", "C and A", "c-and-a"], "external_ids": []},
    {"id": "brand:walmart", "type": "Brand", "name": "walmart", "aliases": ["Walmart", "WALMART"], "external_ids": []},
    {"id": "materialgroup:natural", "type": "MaterialGroup", "name": "natural", "aliases": ["Natural", "natural fibre", "natural fiber"], "external_ids": []},
    {"id": "materialgroup:synthetic", "type": "MaterialGroup", "name": "synthetic", "aliases": ["Synthetic", "man-made"], "external_ids": []},
    {"id": "materialgroup:semi-synthetic", "type": "MaterialGroup", "name": "semi-synthetic", "aliases": ["Semi-synthetic", "regenerated cellulose"], "external_ids": []},
    {"id": "targetgroup:women", "type": "TargetGroup", "name": "women", "aliases": ["Women", "WOMAN", "ladies"], "external_ids": []},
    {"id": "targetgroup:men", "type": "TargetGroup", "name": "men", "aliases": ["Men", "MAN"], "external_ids": []},
    {"id": "targetgroup:girls", "type": "TargetGroup", "name": "girls", "aliases": ["Girls", "GIRL"], "external_ids": []},
    {"id": "targetgroup:boys", "type": "TargetGroup", "name": "boys", "aliases": ["Boys", "BOY"], "external_ids": []},
    {"id": "targetgroup:baby", "type": "TargetGroup", "name": "baby", "aliases": ["Baby", "BABY", "newborn"], "external_ids": []},
    {"id": "currency:gbp", "type": "Currency", "name": "GBP", "aliases": ["gbp", "pound", "pounds", "GBP"], "external_ids": []},
    {"id": "currency:eur", "type": "Currency", "name": "EUR", "aliases": ["eur", "euro", "euros", "EUR"], "external_ids": []},
    {"id": "currency:usd", "type": "Currency", "name": "USD", "aliases": ["usd", "dollar", "dollars", "USD"], "external_ids": []}
  ]
}
