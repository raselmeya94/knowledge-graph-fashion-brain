{
  "source_id": "plmex_products",
  "source_table": "plmex_products",
  "primary_key": ["code"],
  "product_id_template": "plmex:product:{code}",
  "graph_id": "plmex_products",
  "hub_graph_id": "fashion_brain",
  "ontology": "plmex-products-ontology",
  "ontology_version": "2.0.0",
  "ontology_id": "plmex",
  "connection_id": "plmex_postgres",
  "database": "plmex_live",
  "watermark_columns": ["updated_at"],
  "description": "Upgraded plmex_products → Neo4j Fashion Brain mapping. Fixes Material percentage pollution, Gauge/Color normalization, ProductionMethod vs Category hierarchy, InventoryRecord/Shipment collisions, and unifies hubs with ecom via fashion_brain hub IDs.",
  "transforms": {
    "brand_canonical": {
      "from": "brand",
      "op": "canonical_lookup_or_slug",
      "ignore_placeholders": ["UK SHOWROOM SAMPLE", "Shopping Sample(UK)", "BD DESIGN TEAM", "OLDER GIRL", "INFANT"]
    },
    "target_group": {
      "from": "gender",
      "op": "map",
      "map": {
        "Women": "women",
        "Men": "men",
        "Girl": "girls",
        "Boy": "boys",
        "Baby Girl": "baby",
        "Baby Boy": "baby",
        "Maternal & Infants": "baby",
        "Unisex": "unisex",
        "Pets": "pets",
        "Others": "others"
      }
    },
    "season_year_clean": {
      "from": "season_year",
      "op": "regex_replace_map",
      "map": { "2205": "2025" },
      "valid_range": [2010, 2030]
    },
    "style_ref_norm": { "from": "style_reference", "op": "alnum_upper" },
    "cust_ref_norm": { "from": "customer_style_reference", "op": "alnum_upper" },
    "gauge_tokens": {
      "from": "gauge",
      "op": "split_and_normalize_gauge",
      "split": ",",
      "exclude": ["CROCHET"],
      "normalize_regex": ["^(\\d+(?:\\.\\d+)?)G$", "$1GG"]
    },
    "color_tokens": {
      "from": "color",
      "op": "split_and_canonicalize_color",
      "split_regex": "\\s*(?:,|/|\\bAND\\b)\\s*",
      "exclude": ["STRIPES"],
      "alias_map": { "GERY": "GREY", "LIGHT GRAY": "GREY", "MULTI COLOUR": "MULTICOLOUR" }
    }
  },
  "product_properties": {
    "code": { "column": "code", "required": true },
    "composition": { "column": "composition" },
    "category": { "column": "category" },
    "plm_main_category": { "column": "plm_main_category" },
    "plm_sub_category": { "column": "plm_sub_category" },
    "plm_sub_sub_category": { "column": "plm_sub_sub_category" },
    "brand": { "column": "brand" },
    "unit": { "column": "unit" },
    "gauge": { "column": "gauge" },
    "gender": { "column": "gender" },
    "sample_collection_type": { "column": "sample_collection_type" },
    "shipment_quantity": { "column": "shipment_quantity" },
    "shipment_date": { "column": "shipment_date" },
    "garment_type": { "column": "garment_type" },
    "design_for": { "column": "design_for" },
    "knit_machine_type": { "column": "knit_machine_type" },
    "knitting_time": { "column": "knitting_time" },
    "design_feature": { "column": "design_feature" },
    "merchandiser": { "column": "merchandiser" },
    "department": { "column": "department" },
    "shopping_department": { "column": "shopping_department" },
    "season_year": { "column": "season_year" },
    "designer": { "column": "designer" },
    "style_reference": { "column": "style_reference" },
    "customer_style_reference": { "column": "customer_style_reference" },
    "style_feature": { "column": "style_feature" },
    "color": { "column": "color" },
    "weight": { "column": "weight" },
    "gsm": { "column": "gsm" },
    "cuttable_width": { "column": "cuttable_width" },
    "sample_making_date": { "column": "sample_making_date" },
    "current_stock": { "column": "current_stock", "type": "integer" },
    "current_location": { "column": "current_location" },
    "purchased_by": { "column": "purchased_by" },
    "created_by": { "column": "created_by" },
    "created_at": { "column": "created_at" },
    "updated_at": { "column": "updated_at" },
    "buyer": { "column": "buyer" },
    "ai_event_tags": { "column": "ai_event_tags" },
    "ai_construction_tags": { "column": "ai_construction_tags" },
    "ai_material_tags": { "column": "ai_material_tags" },
    "ai_finish_tags": { "column": "ai_finish_tags" },
    "ai_special_tags": { "column": "ai_special_tags" }
  },
  "neo4j_product_properties": [
    "code",
    "composition",
    "unit",
    "knitting_time",
    "weight",
    "gsm",
    "cuttable_width",
    "sample_making_date",
    "shipment_quantity",
    "shipment_date",
    "current_stock",
    "current_location",
    "style_reference",
    "customer_style_reference",
    "display_name",
    "search_text",
    "created_at",
    "updated_at",
    "source"
  ],
  "relationships": [
    {
      "rel_type": "HAS_BRAND",
      "end_type": "Brand",
      "from_transform": "brand_canonical",
      "id_template": "brand:{brand_canonical}",
      "required": false
    },
    {
      "rel_type": "HAS_BUYER",
      "end_type": "Buyer",
      "from_column": "buyer",
      "id_template": "plmex:buyer:{buyer|slug}",
      "required": false
    },
    {
      "rel_type": "USES_MATERIAL",
      "end_type": "Material",
      "from_column": "composition",
      "parse": "composition_percent_tokens",
      "id_template": "fashion:material:{fiber|slug}",
      "edge_properties": ["percentage", "provenance"],
      "required": false,
      "notes": "Strip numbers from Material node name; store percentage on edge ONLY"
    },
    {
      "rel_type": "PRIMARY_MATERIAL",
      "end_type": "Material",
      "from_column": "composition",
      "parse": "highest_percentage_fiber",
      "id_template": "fashion:material:{fiber|slug}",
      "edge_properties": ["percentage"],
      "required": false
    },
    {
      "rel_type": "MADE_WITH_METHOD",
      "end_type": "ProductionMethod",
      "from_column": "category",
      "id_template": "plmex:method:{category|slug}",
      "required": false,
      "notes": "Replaces broken GarmentCategory → PlmMainCategory PARENT_CATEGORY edge"
    },
    {
      "rel_type": "HAS_PLM_MAIN_CATEGORY",
      "end_type": "PlmMainCategory",
      "from_column": "plm_main_category",
      "id_template": "plmex:cat:main:{plm_main_category|slug}",
      "required": false
    },
    {
      "rel_type": "HAS_PLM_SUB_CATEGORY",
      "end_type": "PlmSubCategory",
      "from_column": "plm_sub_category",
      "id_template": "plmex:cat:sub:{plm_sub_category|slug}",
      "required": false
    },
    {
      "rel_type": "HAS_PLM_SUB_SUB_CATEGORY",
      "end_type": "PlmSubSubCategory",
      "from_column": "plm_sub_sub_category",
      "id_template": "plmex:cat:subsub:{plm_sub_sub_category|slug}",
      "required": false
    },
    {
      "rel_type": "PARENT_CATEGORY",
      "start_type": "PlmSubCategory",
      "start_from_column": "plm_sub_category",
      "end_type": "PlmMainCategory",
      "end_from_column": "plm_main_category",
      "required": false
    },
    {
      "rel_type": "PARENT_CATEGORY",
      "start_type": "PlmSubSubCategory",
      "start_from_column": "plm_sub_sub_category",
      "end_type": "PlmSubCategory",
      "end_from_column": "plm_sub_category",
      "required": false
    },
    {
      "rel_type": "HAS_GARMENT_TYPE",
      "end_type": "GarmentType",
      "from_column": "garment_type",
      "id_template": "plmex:garmenttype:{garment_type|slug}",
      "required": false
    },
    {
      "rel_type": "HAS_GENDER",
      "end_type": "Gender",
      "from_column": "gender",
      "id_template": "plmex:gender:{gender|slug}",
      "required": false
    },
    {
      "rel_type": "FOR_TARGET_GROUP",
      "end_type": "TargetGroup",
      "from_transform": "target_group",
      "id_template": "targetgroup:{target_group}",
      "required": false,
      "notes": "Unified bridge to ecom TargetGroup"
    },
    {
      "rel_type": "HAS_COLOR",
      "end_type": "Color",
      "from_transform": "color_tokens",
      "id_template": "fashion:color:{token|slug}",
      "required": false
    },
    {
      "rel_type": "PRIMARY_COLOR",
      "end_type": "Color",
      "from_transform": "color_tokens",
      "pick": "first",
      "id_template": "fashion:color:{token|slug}",
      "required": false
    },
    {
      "rel_type": "HAS_PATTERN",
      "end_type": "Pattern",
      "from_column": "color",
      "required": false,
      "notes": "STRIPES and similar tokens routed from color via normalizer"
    },
    {
      "rel_type": "HAS_GAUGE",
      "end_type": "Gauge",
      "from_transform": "gauge_tokens",
      "id_template": "fashion:gauge:{token|slug}",
      "required": false
    },
    {
      "rel_type": "HAS_SAMPLE_TYPE",
      "end_type": "SampleType",
      "from_column": "sample_collection_type",
      "id_template": "plmex:sampletype:{sample_collection_type|slug}",
      "required": false
    },
    {
      "rel_type": "DESIGNED_FOR",
      "end_type": "DesignPurpose",
      "from_column": "design_for",
      "id_template": "plmex:designpurpose:{design_for|slug}",
      "required": false
    },
    {
      "rel_type": "USES_KNIT_MACHINE",
      "end_type": "MachineType",
      "from_column": "knit_machine_type",
      "id_template": "plmex:machinetype:{knit_machine_type|slug}",
      "required": false
    },
    {
      "rel_type": "HAS_DESIGN_FEATURE",
      "end_type": "DesignFeature",
      "from_column": "design_feature",
      "split_regex": "[,;/]",
      "id_template": "fashion:feature:{token|slug}",
      "required": false
    },
    {
      "rel_type": "HAS_STYLE_FEATURE",
      "end_type": "StyleFeature",
      "from_column": "style_feature",
      "split_regex": "[,;/]",
      "id_template": "fashion:stylefeature:{token|slug}",
      "required": false
    },
    {
      "rel_type": "BELONGS_TO_DEPARTMENT",
      "end_type": "Department",
      "from_column": "department",
      "id_template": "plmex:department:{department|slug}",
      "required": false
    },
    {
      "rel_type": "BELONGS_TO_SHOPPING_DEPARTMENT",
      "end_type": "ShoppingDepartment",
      "from_column": "shopping_department",
      "id_template": "plmex:shoppingdepartment:{shopping_department|slug}",
      "required": false
    },
    {
      "rel_type": "IN_SEASON_YEAR",
      "end_type": "SeasonYear",
      "from_transform": "season_year_clean",
      "id_template": "seasonyear:{season_year_clean}",
      "required": false
    },
    {
      "rel_type": "CREATED_BY",
      "end_type": "Person",
      "from_column": "created_by",
      "id_template": "plmex:person:{created_by|slug}",
      "required": false
    },
    {
      "rel_type": "DESIGNED_BY",
      "end_type": "Person",
      "from_column": "designer",
      "id_template": "plmex:person:{designer|slug}",
      "required": false
    },
    {
      "rel_type": "MANAGED_BY",
      "end_type": "Person",
      "from_column": "merchandiser",
      "id_template": "plmex:person:{merchandiser|slug}",
      "required": false
    },
    {
      "rel_type": "IN_DEPARTMENT",
      "start_type": "Person",
      "start_from_column": "merchandiser",
      "end_type": "Department",
      "end_from_column": "department",
      "required": false
    },
    {
      "rel_type": "PURCHASED_BY",
      "end_type": "Person",
      "from_column": "purchased_by",
      "required": false,
      "notes": "Person when value looks like a person name; else treat as free text on Product"
    },
    {
      "rel_type": "HAS_REFERENCE",
      "end_type": "Reference",
      "from_transform": "style_ref_norm",
      "id_template": "ref:{style_ref_norm}",
      "edge_properties": { "ref_kind": "plm_style_ref" },
      "required": false
    },
    {
      "rel_type": "HAS_REFERENCE",
      "end_type": "Reference",
      "from_transform": "cust_ref_norm",
      "id_template": "ref:{cust_ref_norm}",
      "edge_properties": { "ref_kind": "customer_style_ref" },
      "required": false,
      "notes": "Unified Reference node allows direct Neo4j matching with ecom master_products"
    },
    {
      "rel_type": "HAS_UNIT",
      "end_type": "Unit",
      "from_column": "unit",
      "id_template": "plmex:unit:{unit|slug}",
      "required": false
    },
    {
      "rel_type": "HAS_INVENTORY_RECORD",
      "end_type": "InventoryRecord",
      "from_column": "current_stock",
      "fallback_column": "current_location",
      "id_template": "plmex:inv:{code}",
      "node_properties": ["current_stock", "current_location", "updated_at"],
      "required": false
    },
    {
      "rel_type": "STORED_AT",
      "start_type": "InventoryRecord",
      "start_id_template": "plmex:inv:{code}",
      "end_type": "Location",
      "end_from_column": "current_location",
      "split_regex": "[\\r\\n]+",
      "id_template": "plmex:location:{token|slug}",
      "required": false
    },
    {
      "rel_type": "HAS_SHIPMENT",
      "end_type": "Shipment",
      "from_column": "shipment_date",
      "fallback_column": "shipment_quantity",
      "id_template": "plmex:ship:{code}:{shipment_date|slug}",
      "node_properties": ["shipment_date", "shipment_quantity"],
      "required": false
    },
    {
      "rel_type": "SUITED_FOR_OCCASION",
      "end_type": "Occasion",
      "from_column": "ai_event_tags",
      "split": ",",
      "id_template": "fashion:occasion:{token|slug}",
      "edge_properties": { "provenance": "ai_tag" },
      "required": false
    },
    {
      "rel_type": "HAS_CONSTRUCTION",
      "end_type": "Construction",
      "from_column": "ai_construction_tags",
      "split": ",",
      "id_template": "fashion:construction:{token|slug}",
      "edge_properties": { "provenance": "ai_tag" },
      "required": false
    },
    {
      "rel_type": "HAS_AI_MATERIAL_TAG",
      "end_type": "AiMaterialTag",
      "from_column": "ai_material_tags",
      "split": ",",
      "id_template": "fashion:aimaterial:{token|slug}",
      "required": false
    },
    {
      "rel_type": "HAS_FINISH_TAG",
      "end_type": "FinishTag",
      "from_column": "ai_finish_tags",
      "split": ",",
      "id_template": "fashion:finish:{token|slug}",
      "required": false
    },
    {
      "rel_type": "HAS_SPECIAL_TAG",
      "end_type": "SpecialTag",
      "from_column": "ai_special_tags",
      "split": ",",
      "id_template": "fashion:special:{token|slug}",
      "required": false
    }
  ],
  "envelope_only_columns": [],
  "deferred_to_v2": [
    "RELATED_TO_TAG co-occurrence edges between AI tag types",
    "SAME_STYLE_AS / VARIANT_OF product linking",
    "CanonicalCategory MAPS_TO_CATEGORY enrichment (see semantic_bridges.json)",
    "Department ∪ ShoppingDepartment OrgUnit merge"
  ]
}
