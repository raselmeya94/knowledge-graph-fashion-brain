      "type": "Brand",
      "name": "matalan",
      "aliases": [
        "Matalan",
        "MATALAN"
      ],
      "external_ids": []
    },
    {
      "id": "brand:c-and-a",
      "type": "Brand",
      "name": "c-and-a",
      "aliases": [
        "C&A",
        "c&a",
        "C and A",
        "c-and-a"
      ],
      "external_ids": []
    },
    {
      "id": "brand:walmart",
      "type": "Brand",
      "name": "walmart",
      "aliases": [
        "Walmart",
        "WALMART"
      ],
      "external_ids": []
    }
  ]
}
