# Copy to .env for local development. Placeholder values only.
# Do not put production credentials, private documents, or live PLMEX DSNs here.

FASHIONGPT_ENV=development
# Paths are relative to the repo data/ directory (not knowledge_graph/).
FASHIONGPT_RAW_DATA_DIR=raw
FASHIONGPT_GENERATED_DIR=generated
# Optional classic path; API-created ontologies live under schemas/ontologies/<id>.json
# Prefer POST /ontologies (see knowledge_graph/POSTMAN.md) on a fresh device.
FASHIONGPT_ONTOLOGY_PATH=schemas/ontologies/ecom.json
FASHIONGPT_NEWS_ONTOLOGY_PATH=schemas/ontologies/news.json
FASHIONGPT_REVIEW_DECISIONS_PATH=config/entity_reviews.json

# Prefer neo4j for production-like local runs (docker compose up -d). memory needs no DB.
FASHIONGPT_GRAPH_BACKEND=neo4j
FASHIONGPT_NEO4J_URI=bolt://localhost:7687
FASHIONGPT_NEO4J_USER=neo4j
# Must match docker-compose.yml NEO4J_AUTH (default password: fashiongpt-local-dev)
FASHIONGPT_NEO4J_PASSWORD=fashiongpt-local-dev
FASHIONGPT_NEO4J_DATABASE=neo4j

# Leave empty in local development to allow unauthenticated demo access.
# Set a token in any shared or staging environment.
FASHIONGPT_API_TOKEN=
FASHIONGPT_API_HOST=127.0.0.1
FASHIONGPT_API_PORT=8000
# Fashion Brain user/admin JWT auth (SQLite at generated/fashion_brain/app.db).
FASHIONGPT_JWT_SECRET=
FASHIONGPT_JWT_ACCESS_MINUTES=60
FASHIONGPT_JWT_REFRESH_DAYS=14
FASHIONGPT_ADMIN_BOOTSTRAP_SECRET=
FASHIONGPT_FASHION_BRAIN_DB=generated/fashion_brain/app.db
# Comma-separated browser origins allowed to call the Fashion Brain API (frontend project).
# Empty uses local defaults: 5173, 5500, 3000.
# Comma-separated browser origins for the separate frontend (npm start on :5173).
# In development, private LAN origins are also allowed automatically.
# Example: http://127.0.0.1:5173,http://localhost:5173,http://192.168.20.110:5173
FASHIONGPT_CORS_ORIGINS=
# Knowledge-graph construction API. Separate from the Fashion Brain server.
FASHIONGPT_KG_API_HOST=127.0.0.1
FASHIONGPT_KG_API_PORT=8001
# Fashion Brain retrieves evidence from this URL. Leave empty only for local unit tests.
FASHIONGPT_KG_URL=http://127.0.0.1:8001
# 0 means no deadline. A positive number is a limit in seconds.
FASHIONGPT_REQUEST_TIMEOUT_SECONDS=0

# Answers are written by OpenRouter from retrieved product evidence.
# Put the key in .env or in OPENROUTER_API_KEY. Do not commit it.
FASHIONGPT_EXTRACTION_MODE=deterministic
FASHIONGPT_ANSWER_MODE=llm
FASHIONGPT_MODEL_PROVIDER=openrouter
FASHIONGPT_MODEL_BASE_URL=https://openrouter.ai/api/v1
FASHIONGPT_MODEL_API_KEY=
FASHIONGPT_MODEL_NAME=~openai/gpt-sol-latest
FASHIONGPT_MODEL_APP_URL=http://127.0.0.1:8000
FASHIONGPT_MODEL_APP_TITLE=Fashion Brain
# Sample garment images always use OpenRouter (even when chat is ollama).
FASHIONGPT_IMAGE_MODEL=google/gemini-3.1-flash-image
FASHIONGPT_EMBEDDING_PROVIDER=lexical
FASHIONGPT_RESOLUTION_SIMILARITY=off

# Local Ollama used by the knowledge-graph construction tools.
# Text and relationship tools fall back to deterministic extraction when it is down.
FASHIONGPT_OLLAMA_BASE_URL=http://127.0.0.1:11434
FASHIONGPT_OLLAMA_MODEL=llama3.1:8b
FASHIONGPT_OLLAMA_VISION_MODEL=
FASHIONGPT_OLLAMA_TIMEOUT_SECONDS=60

FASHIONGPT_LOG_LEVEL=INFO
FASHIONGPT_LOG_JSON=true

# Keep the PLMEX SQL connector off unless you have an authorized DSN.
FASHIONGPT_SQL_ENABLED=false
FASHIONGPT_SQL_DSN=

# E-comm scrape Postgres (localhost). Put YOUR credentials here — do not commit secrets.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=fashion_brain
# Built from the POSTGRES_* values, or set the full URL directly:
# FASHIONGPT_ECOM_DSN=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
FASHIONGPT_ECOM_DSN=
FASHIONGPT_ECOM_SYNC_BATCH_SIZE=500
# Optional cap for a first test sync (empty = all rows).
FASHIONGPT_ECOM_SYNC_LIMIT=
