{
  "source_id": "ecom_products",
  "source_table": "master_products",
  "primary_key": [
    "brand",
    "master_id"
  ],
  "product_id_template": "ecom:{brand}:{master_id}",
  "graph_id": "ecom_products",
  "hub_graph_id": "fashion_brain",
  "ontology": "ecom-products-ontology",
  "ontology_version": "2.0.0",
  "ontology_id": "ecom",
  "watermark_columns": [
    "updated_at",
    "content_hash"
  ],
  "description": "Upgraded master_products \u2192 Neo4j Fashion Brain mapping. Keeps source graph_id ecom_products for registry, writes shared hubs (Brand/Material/Color/Reference/TargetGroup) into fashion_brain namespace, with explicit transforms and cross-source bridges.",
  "transforms": {
    "brand_norm": {
      "from": "brand",
      "op": "lowercase_slug"
    },
    "price_num": {
      "from": "price",
      "op": "parse_decimal"
    },
    "original_price_num": {
      "from": "original_price",
      "op": "parse_decimal"
    },
    "discount_pct": {
      "from": [
        "original_price_num",
        "price_num"
      ],
      "op": "pct_discount"
    },
    "price_band": {
      "from": [
        "price_num",
        "currency"
      ],
      "op": "bucket",
      "buckets": {
        "budget": [
          0,
          15
        ],
        "value": [
          15,
          35
        ],
        "mid": [
          35,
          75
        ],
        "premium": [
          75,
          10000
        ]
      }
    },
    "ref_norm": {
      "from": [
        "reference",
        "display_reference"
      ],
      "op": "coalesce_alnum_upper"
    },
    "target_group": {
      "from": [
        "section",
        "category_path"
      ],
      "op": "rule_map",
      "rules": {
        "woman|women|ladies": "women",
        "man|men": "men",
        "girl|girls": "girls",
        "boy|boys": "boys",
        "baby|newborn|infant": "baby",
        "kids|children": "kids",
        "unisex": "unisex"
      }
    }
  },
  "product_properties": {
    "master_id": {
      "column": "master_id",
      "required": true
    },
    "brand": {
      "column": "brand",
      "required": true
    },
    "product_name": {
      "column": "name"
    },
    "reference": {
      "column": "reference"
    },
    "display_reference": {
      "column": "display_reference"
    },
    "description": {
      "column": "description"
    },
    "composition": {
      "column": "composition"
    },
    "composition_detail": {
      "column": "composition_detail",
      "type": "jsonb"
    },
    "construction": {
      "column": "construction"
    },
    "care": {
      "column": "care"
    },
    "fit": {
      "column": "fit"
    },
    "country_of_origin": {
      "column": "country_of_origin"
    },
    "section": {
      "column": "section"
    },
    "category": {
      "column": "category"
    },
    "family": {
      "column": "family"
    },
    "subfamily": {
      "column": "subfamily"
    },
    "category_path": {
      "column": "category_path"
    },
    "availability": {
      "column": "availability"
    },
    "in_stock_count": {
      "column": "in_stock_count",
      "type": "integer"
    },
    "out_stock_count": {
      "column": "out_stock_count",
      "type": "integer"
    },
    "currency": {
      "column": "currency"
    },
    "price": {
      "column": "price"
    },
    "original_price": {
      "column": "original_price"
    },
    "price_min": {
      "column": "price_min"
    },
    "price_max": {
      "column": "price_max"
    },
    "image": {
      "column": "image"
    },
    "images": {
      "column": "images",
      "type": "jsonb",
      "store": "envelope_only"
    },
    "colors": {
      "column": "colors",
      "type": "jsonb"
    },
    "color_count": {
      "column": "color_count",
      "type": "integer"
    },
    "product_url": {
      "column": "product_url"
    },
    "product_url_with_variant": {
      "column": "product_url_with_variant"
    },
    "source_url": {
      "column": "source_url"
    },
    "domain": {
      "column": "domain"
    },
    "catalog_id": {
      "column": "catalog_id"
    },
    "scraped_at": {
      "column": "scraped_at"
    },
    "content_hash": {
      "column": "content_hash"
    },
    "pdp_enriched": {
      "column": "pdp_enriched",
      "type": "boolean"
    }
  },
  "neo4j_product_properties": [
    "master_id",
    "brand",
    "name",
    "description",
    "composition",
    "construction",
    "care",
    "fit",
    "reference",
    "display_reference",
    "ref_norm",
    "price",
    "price_num",
    "original_price",
    "original_price_num",
    "discount_pct",
    "price_min",
    "price_max",
    "currency",
    "availability",
    "in_stock_count",
    "out_stock_count",
    "color_count",
    "product_url",
    "product_url_with_variant",
    "image",
    "category_path",
    "country_of_origin",
    "pdp_enriched",
    "search_text",
    "source",
    "scraped_at",
    "content_hash"
  ],
  "relationships": [
    {
      "rel_type": "HAS_BRAND",
      "end_type": "Brand",
      "from_column": "brand",
      "id_template": "brand:{brand_norm}",
      "required": true
    },
    {
      "rel_type": "SCRAPED_FROM",
      "end_type": "Domain",
      "from_column": "domain",
      "id_template": "domain:{domain}",
      "required": false
    },
    {
      "rel_type": "IN_CATALOG",
      "end_type": "Catalog",
      "from_column": "catalog_id",
      "id_template": "catalog:{catalog_id}",
      "required": false
    },
    {
      "rel_type": "HAS_SECTION",
      "end_type": "Section",
      "from_column": "section",
      "id_template": "ecom:section:{section|slug}",
      "required": false
    },
    {
      "rel_type": "FOR_TARGET_GROUP",
      "end_type": "TargetGroup",
      "from_transform": "target_group",
      "id_template": "targetgroup:{target_group}",
      "edge_properties": {
        "provenance": "rule"
      },
      "required": false
    },
    {
      "rel_type": "BELONGS_TO_CATEGORY",
      "end_type": "GarmentCategory",
      "from_column": "category",
      "id_template": "ecom:cat:{category|slug}",
      "required": false
    },
    {
      "rel_type": "HAS_FAMILY",
      "end_type": "Family",
      "from_column": "family",
      "id_template": "ecom:family:{family|slug}",
      "required": false
    },
    {
      "rel_type": "HAS_SUBFAMILY",
      "end_type": "Subfamily",
      "from_column": "subfamily",
      "id_template": "ecom:subfamily:{subfamily|slug}",
      "required": false
    },
    {
      "rel_type": "PARENT_CATEGORY",
      "start_type": "Subfamily",
      "start_from_column": "subfamily",
      "end_type": "Family",
      "end_from_column": "family",
      "required": false
    },
    {
      "rel_type": "PARENT_CATEGORY",
      "start_type": "Family",
      "start_from_column": "family",
      "end_type": "GarmentCategory",
      "end_from_column": "category",
      "required": false
    },
    {
      "rel_type": "USES_MATERIAL",
      "end_type": "Material",
      "from_column": "composition_detail",
      "fallback_column": "composition",
      "parse": "composition_percent_map",
      "id_template": "fashion:material:{fiber|slug}",
      "edge_properties": [
        "percentage",
        "part",
        "provenance"
      ],
      "required": false,
      "notes": "Fiber name only on Material node; percentage on edge"
    },
    {
      "rel_type": "PRIMARY_MATERIAL",
      "end_type": "Material",
      "from_column": "composition_detail",
      "fallback_column": "composition",
      "parse": "highest_percentage_fiber",
      "id_template": "fashion:material:{fiber|slug}",
      "edge_properties": [
        "percentage"
      ],
      "required": false
    },
    {
      "rel_type": "HAS_COLOR",
      "end_type": "Color",
      "from_column": "colors",
      "parse": "jsonb_color_list_to_canonical",
      "id_template": "fashion:color:{color_canonical|slug}",
      "edge_properties": [
        "raw_name",
        "hex"
      ],
      "required": false
    },
    {
      "rel_type": "PRIMARY_COLOR",
      "end_type": "Color",
      "from_column": "colors",
      "parse": "first_jsonb_color_to_canonical",
      "id_template": "fashion:color:{color_canonical|slug}",
      "required": false
    },
    {
      "rel_type": "HAS_AVAILABILITY",
      "end_type": "Availability",
      "from_column": "availability",
      "id_template": "availability:{availability|slug}",
      "required": false
    },
    {
      "rel_type": "PRICED_IN",
      "end_type": "Currency",
      "from_column": "currency",
      "id_template": "currency:{currency|lower}",
      "required": false
    },
    {
      "rel_type": "IN_PRICE_BAND",
      "end_type": "PriceBand",
      "from_transform": "price_band",
      "id_template": "priceband:{currency|lower}:{price_band}",
      "required": false
    },
    {
      "rel_type": "HAS_CONSTRUCTION",
      "end_type": "Construction",
      "from_column": "construction",
      "id_template": "fashion:construction:{construction|slug}",
      "required": false
    },
    {
      "rel_type": "HAS_FIT",
      "end_type": "Fit",
      "from_column": "fit",
      "id_template": "fashion:fit:{fit|slug}",
      "required": false
    },
    {
      "rel_type": "HAS_CARE",
      "end_type": "CareInstruction",
      "from_column": "care",
      "split": "comma_or_semicolon",
      "id_template": "fashion:care:{item|slug}",
      "required": false
    },
    {
      "rel_type": "MADE_IN",
      "end_type": "Country",
      "from_column": "country_of_origin",
      "id_template": "country:{country_of_origin|iso_or_slug}",
      "required": false
    },
    {
      "rel_type": "HAS_REFERENCE",
      "end_type": "Reference",
      "from_transform": "ref_norm",
      "id_template": "ref:{ref_norm}",
      "edge_properties": {
        "ref_kind": "ecom_ref"
      },
      "required": false
    },
    {
      "rel_type": "HAS_MAIN_IMAGE",
      "end_type": "Image",
      "from_column": "image",
      "id_template": "img:{image|sha1}",
      "required": false
    }
  ],
  "envelope_only_columns": [
    "catalog_product_ids",
    "product_ids",
    "prices_seen",
    "images",
    "product_urls",
    "seo_product_id",
    "primary_product_id",
    "enriched_from",
    "scrape_job_id",
    "colorway_hash",
    "last_changed_at"
  ],
  "deferred_to_v2": [
    "HAS_LISTING / ProductListing from catalog_product_ids",
    "HAS_PRICE_SNAPSHOT / HAS_PRICE_CHANGE from prices_seen",
    "HAS_IMAGE multi from images jsonb",
    "LLM style attrs (silhouette, neckline, sleeve, pattern, occasion, season, style_tag, certification)",
    "SizeAvailability (needs per-size scraper export)",
    "colorways child tables (*_colorways)",
    "brand dump tables (zara_products, primark_products, \u2026)",
    "product_change_events"
  ]
}
